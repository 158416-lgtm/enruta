# Copia a .env y ajusta. Nunca se versiona.
# Para procesos locales (mvn spring-boot:run) el broker se expone en 29092
# y PostgreSQL del compose en 5433 (el 5432 lo usa el PostgreSQL del sistema).

KAFKA_BOOTSTRAP=localhost:29092
DB_USER=enruta
DB_PASSWORD=enruta

# Puertos publicos
GATEWAY_URL=http://localhost:18080
AUTH_URL=http://localhost:8081
SHIPMENT_URL=http://localhost:8082
DISPATCH_URL=http://localhost:8083
TRACKING_URL=http://localhost:8084
ROUTING_URL=http://localhost:8085
NOTIFICATION_URL=http://localhost:8086

JWT_ISSUER=http://localhost:18080
WEBHOOK_SECRET=change-me

# Simulador
SIM_DRIVER_COUNT=6
SIM_TICK_INTERVAL=2s
