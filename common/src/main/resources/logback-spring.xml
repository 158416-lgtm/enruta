<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <springProperty scope="local" name="SERVICE_NAME" source="spring.application.name" defaultValue="unknown"/>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <customFields>{"service":"${SERVICE_NAME}"}</customFields>
    </encoder>
  </appender>

  <appender name="STDOUT_PLAIN" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <springProfile name="plain">
    <root level="INFO">
      <appender-ref ref="STDOUT_PLAIN"/>
    </root>
  </springProfile>

  <springProfile name="!plain">
    <root level="INFO">
      <appender-ref ref="STDOUT"/>
    </root>
  </springProfile>

  <logger name="com.enruta" level="DEBUG"/>
  <logger name="org.apache.kafka" level="WARN"/>
  <logger name="org.hibernate" level="WARN"/>
</configuration>
